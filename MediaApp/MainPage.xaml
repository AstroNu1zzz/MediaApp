<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MediaApp.MainPage"
             BackgroundColor="#000000">

    <ScrollView>
        
        <VerticalStackLayout Padding="24, 60, 24, 40" Spacing="0" VerticalOptions="Center">

            <toolkit:MediaElement x:Name="AudioPlayer"
                               Source="embed://Hush.mp3"
                               ShouldAutoPlay="False"
                               ShouldShowPlaybackControls="False"
                               HeightRequest="1"
                               WidthRequest="1"
                               Opacity="0" />
            <Image Source="logo.png"
                   HeightRequest="220"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0, 0, 0, 40" />

            <Label Text="Imágenes y videos"
                   FontFamily="MilkyCream"
                   FontSize="34"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   HorizontalOptions="Center"
                   Margin="0, 0, 0, 8" />

            <Label Text="Selecciona el tipo de contenido."
                   FontSize="16"
                   TextColor="#8E8E93"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0, 0, 0, 48" />

            <VerticalStackLayout Spacing="16" Margin="16, 0">

                <Button x:Name="VerVideo"
                        Text="Ver video"
                        Clicked="VerVideoClicked"
                        BackgroundColor="#FFFFFF"
                        TextColor="#000000"
                        FontSize="17"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="54" />

                <Button x:Name="AudioBtn"
                        Text="Audio"
                        Clicked="AudioBtnClicked"
                        BackgroundColor="#1C1C1E"
                        TextColor="#FFFFFF"
                        FontSize="17"
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="54" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>